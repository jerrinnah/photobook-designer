{
  "name": "photobook-designer",
  "productName": "AutoBook by NEJ",
  "version": "1.0.0",
  "description": "AI-assisted photobook designer with editorial templates, autosave, and print-ready export.",
  "author": "Jerry Nnah <devjerrynnah@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://autobookbynej.online",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --x64",
    "electron:build:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "konva": "^10.2.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-konva": "^19.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  },
  "build": {
    "appId": "com.studio.photobook-designer",
    "productName": "Photobook Designer",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "Photobook Designer",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
