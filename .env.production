# Public site URL — used as the magic-link return destination so it
# never lands on localhost when the user signs in from production.
VITE_SITE_URL=https://autobookbynej.online

# Paystack — replace pk_test_... with your live key when ready.
# Public key is safe to ship in the bundle. NEVER add the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_8292e9324f9e0b5837575d1e215186defdb666b5
VITE_PAYSTACK_CURRENCY=NGN
# Pricing per plan (major unit, e.g. NGN)
VITE_STARTER_PRICE=5000
VITE_PRO_PRICE=45000

# Flutterwave — handles the GBP path. Paystack doesn't accept Pounds, so
# we open the Flutterwave inline checkout whenever the active currency
# is GBP. Get the LIVE public key from:
#   https://dashboard.flutterwave.com/dashboard/settings/api
# and replace the placeholder below.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-eb6566f6b76dcd406159f452ca61859c-X

# Desktop app download URLs — upload the installers to your cPanel
# under /public_html/downloads/ then leave these as the public paths.
# Replace the filenames below with what you actually uploaded.
VITE_DESKTOP_MAC_URL=/downloads/AutoBook-mac.dmg
VITE_DESKTOP_WINDOWS_URL=/downloads/AutoBook-windows.exe
